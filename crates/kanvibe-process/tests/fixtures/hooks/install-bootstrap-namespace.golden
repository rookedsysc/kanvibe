__kanvibe_socket_dir="/tmp/kv-$(id -u)"; kanvibe_parent_trusted=; { [ ! -L "${__kanvibe_socket_dir}" ] && [ -O "${__kanvibe_socket_dir}" ] && [ "$(ls -ld "${__kanvibe_socket_dir}" 2>/dev/null | cut -c1-10)" = "drwx------" ]; } && kanvibe_parent_trusted=1; __kanvibe_socket_dir="${__kanvibe_socket_dir}/qa-fixture"; __kanvibe_socket="${__kanvibe_socket_dir}/hooks-v1.sock"; { [ "$kanvibe_parent_trusted" = 1 ] && [ ! -L "${__kanvibe_socket_dir}" ] && [ -O "${__kanvibe_socket_dir}" ] && [ "$(ls -ld "${__kanvibe_socket_dir}" 2>/dev/null | cut -c1-10)" = "drwx------" ] && [ ! -L "${__kanvibe_socket}" ] && [ -S "${__kanvibe_socket}" ] && [ -O "${__kanvibe_socket}" ]; } || __kanvibe_socket= && __kanvibe_url='http://192.168.0.10:9736/api/install/hooks.sh' && [ -n "$__kanvibe_socket" ] && __kanvibe_install_script=$(curl --unix-socket "$__kanvibe_socket" --connect-timeout 3 --max-time 10 -fsSL -H 'x-kanvibe-install-token: abababababababababababababababababababababababab' -H 'x-kanvibe-client-id: 1b9d6bcd-bbfd-4b2d-9b5d-ab8dfbbd4bed' "$__kanvibe_url" 2>/dev/null) && __kanvibe_install_checksum=$(printf '%s\n' "$__kanvibe_install_script" | { sha256sum 2>/dev/null || shasum -a 256; } | cut -d' ' -f1) && [ "$__kanvibe_install_checksum" = 'cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc' ] && printf '%s\n' "$__kanvibe_install_script" | sh