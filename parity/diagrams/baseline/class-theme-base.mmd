---
config:
  theme: base
  themeVariables:
    primaryColor: '#BB2528'
    primaryTextColor: '#ffffff'
    primaryBorderColor: '#7C0000'
    lineColor: '#F8B229'
    secondaryColor: '#006100'
    tertiaryColor: '#fff4dd'
---
classDiagram
    direction LR
    class Shape {
        <<abstract>>
        +area()* double
        +count()$ int
    }
    class Empty
    Shape <|-- Circle
    Circle --> Circle : self
    Circle ..|> Drawable
    Shape "1" o-- "*" Point : vertices
    Circle --() Printable
    note for Circle "round<br>shape"
    note "free note"
