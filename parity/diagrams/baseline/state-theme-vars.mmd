%%{init: {"themeVariables": {"mainBkg": "#fde68a", "stateBkg": "#fde68a", "nodeBorder": "#b45309", "stateBorder": "#b45309", "transitionColor": "#dc2626", "transitionLabelColor": "#065f46", "stateLabelColor": "#7c2d12", "compositeBackground": "#e0f2fe", "compositeTitleBackground": "#bae6fd", "altBackground": "#f0fdf4", "noteBkgColor": "#fce7f3", "noteBorderColor": "#be185d", "noteTextColor": "#831843", "lineColor": "#2563eb", "specialStateColor": "#7c3aed", "innerEndBackground": "#7c3aed", "labelBackgroundColor": "#fef9c3", "edgeLabelBackground": "#fef9c3", "textColor": "#1e3a8a"}}}%%
stateDiagram-v2
    direction LR
    classDef hot fill:#f96,stroke:#333
    [*] --> Idle
    Idle --> Busy : go
    state "Long description" as Busy
    Busy : first line
    Busy : second line
    state Parallel {
        [*] --> A
        A --> B
        --
        [*] --> C
        C --> [*]
    }
    Busy --> Parallel
    state Gate <<choice>>
    Parallel --> Gate
    Gate --> Idle : retry
    Gate --> Out:::hot
    state Bar <<join>>
    Out --> Bar
    Bar --> [*]
    note left of Idle
        waiting for
        input
    end note
