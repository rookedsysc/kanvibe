{
  "seq": 104,
  "id": "mobile.panes.connection.tls-local-task",
  "group": "tasks",
  "route": "POST /api/mobile/tasks/:taskId/panes/:paneId/connection",
  "title": "TLS request for a local tmux task (no remote Herdr grant)",
  "transport": "http",
  "request": {
    "method": "POST",
    "path": "/api/mobile/tasks/{{var:task_id}}/panes/%250/connection",
    "listener": "tls",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}"
    }
  },
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "success": true,
      "connection": null
    },
    "tls": {
      "peer_certificate_sha256": "{{var:tls_fingerprint}}"
    }
  }
}
