{
  "seq": 17,
  "id": "mobile.pair.ok-tls",
  "group": "pairing",
  "route": "POST /api/mobile/pair",
  "title": "Flutter pairing over TLS: token returned, certificate fingerprint captured for pinning",
  "transport": "http",
  "request": {
    "method": "POST",
    "path": "/api/mobile/pair",
    "listener": "tls",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "code": "{{var:pairing_code}}",
      "deviceName": "Contract Phone"
    }
  },
  "capture": {
    "pair_token": "body.token"
  },
  "oracles": [
    {
      "name": "issue_pairing_code",
      "save": {
        "pairing_code": "code"
      }
    }
  ],
  "setup": [
    "oracle issue_pairing_code (desktop settings screen equivalent)"
  ],
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "token": "{{any:hex64}}"
    },
    "tls": {
      "peer_certificate_sha256": "{{var:tls_fingerprint}}"
    }
  }
}
