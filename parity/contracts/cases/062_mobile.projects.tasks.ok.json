{
  "seq": 62,
  "id": "mobile.projects.tasks.ok",
  "group": "projects",
  "route": "GET /api/mobile/projects/:id/tasks",
  "title": "tasks of a project",
  "transport": "http",
  "request": {
    "method": "GET",
    "path": "/api/mobile/projects/{{var:project_id}}/tasks",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}"
    }
  },
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "tasks": [
        {
          "id": "{{var:main_task_id}}",
          "title": "main",
          "branchName": "main",
          "projectId": "{{var:project_id}}",
          "projectName": "demo",
          "sshHost": null,
          "status": "todo",
          "updatedAt": "{{any:iso8601}}"
        }
      ]
    }
  }
}
