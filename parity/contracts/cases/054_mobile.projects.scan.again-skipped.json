{
  "seq": 54,
  "id": "mobile.projects.scan.again-skipped",
  "group": "projects",
  "route": "POST /api/mobile/projects/scan",
  "title": "rescan reports already-registered projects",
  "transport": "http",
  "request": {
    "method": "POST",
    "path": "/api/mobile/projects/scan",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "rootPath": "{{var:demo_scan_root}}"
    }
  },
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "result": {
        "registered": [],
        "skipped": [
          "{{var:demo_repo}}"
        ],
        "errors": [],
        "worktreeTasks": [],
        "registeredWorktrees": [],
        "hooksSetup": []
      }
    }
  }
}
