{
  "seq": 115,
  "id": "mobile.diff.changed",
  "group": "workspace",
  "route": "GET /api/mobile/tasks/:id/diff",
  "title": "one modified file",
  "transport": "http",
  "request": {
    "method": "GET",
    "path": "/api/mobile/tasks/{{var:task_id}}/diff",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}"
    }
  },
  "oracles": [
    {
      "name": "write_file",
      "args": {
        "path": "{{var:task_worktree}}/notes/todo.txt",
        "content": "first line\nedited in worktree\n"
      }
    }
  ],
  "setup": [
    "writes notes/todo.txt in the task worktree"
  ],
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "files": [
        {
          "path": "notes/todo.txt",
          "status": "modified",
          "additions": 1,
          "deletions": 1
        }
      ]
    }
  }
}
