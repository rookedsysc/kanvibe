{
  "seq": 193,
  "id": "mobile.notifications.read.ok",
  "group": "notifications",
  "route": "PATCH /api/mobile/notifications/:id/read",
  "title": "mark one read",
  "transport": "http",
  "request": {
    "method": "PATCH",
    "path": "/api/mobile/notifications/{{var:notification_id}}/read",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}"
    }
  },
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "notification": {
        "id": "{{var:notification_id}}",
        "title": "demo — feat-a",
        "body": "feat-a: review로 변경\nupdated description",
        "taskId": "{{var:task_id}}",
        "isRead": true,
        "createdAt": "{{any:iso8601}}"
      }
    }
  }
}
