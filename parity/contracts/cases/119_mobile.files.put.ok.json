{
  "seq": 119,
  "id": "mobile.files.put.ok",
  "group": "workspace",
  "route": "PUT /api/mobile/tasks/:id/files",
  "title": "save changed file",
  "transport": "http",
  "request": {
    "method": "PUT",
    "path": "/api/mobile/tasks/{{var:task_id}}/files?path=notes/todo.txt",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "content": "first line\nsaved from phone\n"
    }
  },
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true
    }
  }
}
