{
  "seq": 75,
  "id": "mobile.tasks.search.ok",
  "group": "tasks",
  "route": "GET /api/mobile/tasks/search",
  "title": "searchable tasks (feature route shadows tasks/:id)",
  "transport": "http",
  "request": {
    "method": "GET",
    "path": "/api/mobile/tasks/search",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}"
    }
  },
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "tasks": [
        {
          "id": "{{var:task_id}}",
          "title": "feat-a",
