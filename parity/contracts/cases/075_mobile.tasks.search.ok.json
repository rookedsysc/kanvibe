          "projectId": "{{var:project_id}}",
          "projectName": "demo",
          "sshHost": null,
          "status": "todo",
          "updatedAt": "{{any:iso8601}}"
        },
        {
          "id": "{{any:uuid}}",
          "title": "main",
          "branchName": "main",
          "projectId": "{{var:scratch_project_id}}",
          "projectName": "scratch",
          "sshHost": null,
          "status": "todo",
          "updatedAt": "{{any:iso8601}}"
        },
        {
          "id": "{{var:main_task_id}}",
          "title": "main",
          "branchName": "main",
          "projectId": "{{var:project_id}}",
          "projectName": "demo",
          "sshHost": null,
          "status": "todo",
          "updatedAt": "{{any:iso8601}}"
        }
      ]
    }
