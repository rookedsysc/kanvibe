{
  "seq": 96,
  "id": "mobile.tabs.move.ok",
  "group": "tasks",
  "route": "POST /api/mobile/tasks/:id/tabs/:tabId/move",
  "title": "move second tab first",
  "transport": "http",
  "request": {
    "method": "POST",
    "path": "/api/mobile/tasks/{{var:task_id}}/tabs/{{var:second_tab_id}}/move",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "index": 0
    }
  },
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "tabs": [
        {
          "id": "@1",
          "nativeIndex": 0,
          "name": "{{regex:tmux|bash|logs}}",
          "isActive": true
        },
        {
          "id": "@0",
          "nativeIndex": 1,
          "name": "{{regex:tmux|bash|logs}}",
          "isActive": false
        }
      ]
    }
  }
}
