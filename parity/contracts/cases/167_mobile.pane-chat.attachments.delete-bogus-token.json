{
  "seq": 167,
  "id": "mobile.pane-chat.attachments.delete-bogus-token",
  "group": "pane-chat",
  "route": "DELETE /api/mobile/tasks/:taskId/pane-chat/attachments",
  "title": "remove attachment with a stale target token",
  "transport": "http",
  "request": {
    "method": "DELETE",
    "path": "/api/mobile/tasks/{{var:task_id}}/pane-chat/attachments",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "targetToken": "bogus-token",
      "id": "att-1"
    }
  },
  "expect": {
    "status": 400,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": false,
      "error": "첨부 파일 식별자가 올바르지 않습니다."
    }
  }
}
