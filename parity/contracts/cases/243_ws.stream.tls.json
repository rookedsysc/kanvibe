{
  "seq": 243,
  "id": "ws.stream.tls",
  "group": "ws",
  "route": "WS /api/mobile/stream",
  "title": "stream over WSS",
  "transport": "ws",
  "request": {
    "path": "/api/mobile/stream?taskId={{var:task_id}}&paneId=%250",
    "listener": "tls",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}"
    }
  },
  "steps": [
    {
      "op": "send_binary",
      "json": {
        "type": "resize",
        "cols": 100,
        "rows": 30
      }
    },
    {
      "op": "recv",
      "timeout": 10
    },
    {
      "op": "close"
    }
  ],
  "expect": {
    "handshake": {
      "status": 101,
      "tls": {
        "peer_certificate_sha256": "{{var:tls_fingerprint}}"
      }
    },
    "frames": [
      {
        "kind": "text",
        "text": "{{any:string}}"
      }
    ]
  }
}
