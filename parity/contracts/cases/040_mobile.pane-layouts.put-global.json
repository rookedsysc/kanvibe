{
  "seq": 40,
  "id": "mobile.pane-layouts.put-global",
  "group": "settings",
  "route": "PUT /api/mobile/pane-layouts",
  "title": "save a global layout",
  "transport": "http",
  "request": {
    "method": "PUT",
    "path": "/api/mobile/pane-layouts",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "layoutType": "horizontal_2",
      "isGlobal": true,
      "panes": [
        {
          "position": 0,
          "command": ""
        },
        {
          "position": 1,
          "command": "git status"
        }
      ]
    }
  },
  "capture": {
    "layout_id": "body.layout.id"
  },
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "layout": {
        "layoutType": "horizontal_2",
        "panes": [
          {
            "position": 0,
            "command": ""
          },
          {
            "position": 1,
            "command": "git status"
          }
        ],
        "projectId": null,
        "isGlobal": true,
        "id": "{{any:uuid}}",
        "createdAt": "{{any:iso8601}}",
        "updatedAt": "{{any:iso8601}}"
      }
    }
  }
}
