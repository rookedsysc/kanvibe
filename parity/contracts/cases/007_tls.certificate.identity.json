{
  "seq": 7,
  "id": "tls.certificate.identity",
  "group": "tls",
  "route": "TLS certificate",
  "transport": "tls-certificate",
  "title": "self-signed certificate on hook port + 10; fingerprint = sha256(DER) lowercase hex, pinned by the app",
  "capture": {
    "tls_fingerprint": "peer_certificate_sha256"
  },
  "expect": {
    "peer_certificate_sha256": "{{any:hex64}}",
    "tls_version_at_least_1_2": true,
    "certificate": {
      "subject_common_name": "KanVibe Desktop",
      "is_self_issued": true,
      "key_type": "rsa",
      "key_bits": 2048,
      "signature_hash": "sha256",
      "validity_days": 7300
    }
  }
}
