{
  "seq": 16,
  "id": "mobile.pair.wrong-code-401",
  "group": "pairing",
  "route": "POST /api/mobile/pair",
  "title": "no live pairing code",
  "transport": "http",
  "request": {
    "method": "POST",
    "path": "/api/mobile/pair",
    "listener": "tls",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "code": "000000",
      "deviceName": "Wrong"
    }
  },
  "expect": {
    "status": 401,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": false,
      "error": "코드가 맞지 않거나 만료되었습니다"
    },
    "tls": {
      "peer_certificate_sha256": "{{var:tls_fingerprint}}"
    }
  }
}
