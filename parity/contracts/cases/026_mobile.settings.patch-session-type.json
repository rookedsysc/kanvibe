{
  "seq": 26,
  "id": "mobile.settings.patch-session-type",
  "group": "settings",
  "route": "PATCH /api/mobile/settings",
  "title": "switch default session type to tmux before any project is registered",
  "transport": "http",
  "request": {
    "method": "PATCH",
    "path": "/api/mobile/settings",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "defaultSessionType": "tmux"
    }
  },
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "settings": {
        "defaultSessionType": "tmux",
        "sortPreference": {
          "keys": []
        },
        "doneAlertDismissed": false,
        "backgroundSync": {
          "isEnabled": false,
          "intervalMs": 600000
        }
      }
    }
  }
}
