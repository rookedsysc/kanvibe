{
  "seq": 34,
  "id": "mobile.notification-settings.patch",
  "group": "settings",
  "route": "PATCH /api/mobile/notification-settings",
  "title": "enable done notifications",
  "transport": "http",
  "request": {
    "method": "PATCH",
    "path": "/api/mobile/notification-settings",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "isEnabled": true,
      "enabledStatuses": [
        "progress",
        "pending",
        "review",
        "done"
      ]
    }
  },
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "settings": {
        "isEnabled": true,
        "enabledStatuses": [
          "progress",
          "pending",
          "review",
          "done"
        ]
      }
    }
  }
}
