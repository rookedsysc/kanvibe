{
  "seq": 116,
  "id": "mobile.diff-stats.ok",
  "group": "workspace",
  "route": "GET /api/mobile/diff-stats",
  "title": "per-task diff stats",
  "transport": "http",
  "request": {
    "method": "GET",
    "path": "/api/mobile/diff-stats",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}"
    }
  },
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "stats": {
        "{{var:task_id}}": {
          "fileCount": 1,
          "additions": 1,
          "deletions": 1
        }
      }
    }
  }
}
