{
  "seq": 109,
  "id": "mobile.panes.image.large-under-limit-400",
  "group": "tasks",
  "route": "POST /api/mobile/tasks/:id/panes/:paneId/image",
  "title": "200 KiB body is accepted by the 3 MiB route limit and rejected by validation instead",
  "transport": "http",
  "request": {
    "method": "POST",
    "path": "/api/mobile/tasks/{{var:task_id}}/panes/%250/image",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}",
      "Content-Type": "application/json"
    },
    "body_fill": {
      "bytes": 204800,
      "prefix": "{\"mimeType\":\"image/png\",\"base64\":\"",
      "suffix": "\"}"
    }
  },
  "expect": {
    "status": 400,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": false,
      "error": "이미지 내용과 형식이 맞지 않습니다"
    }
  }
}
