{
  "seq": 112,
  "id": "mobile.workspace-file.outside-400",
  "group": "workspace",
  "route": "GET /api/mobile/tasks/:taskId/workspace-file",
  "title": "path escapes the worktree",
  "transport": "http",
  "request": {
    "method": "GET",
    "path": "/api/mobile/tasks/{{var:task_id}}/workspace-file?path=../../../../etc/hostname",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}"
    }
  },
  "expect": {
    "status": 400,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": false,
      "error": "작업 폴더 밖의 파일은 열 수 없습니다",
      "reason": "outside-worktree"
    }
  }
}
