{
  "seq": 113,
  "id": "mobile.workspace-file.not-found-404",
  "group": "workspace",
  "route": "GET /api/mobile/tasks/:taskId/workspace-file",
  "title": "missing file",
  "transport": "http",
  "request": {
    "method": "GET",
    "path": "/api/mobile/tasks/{{var:task_id}}/workspace-file?path=missing.txt",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}"
    }
  },
  "expect": {
    "status": 404,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": false,
      "error": "파일을 찾을 수 없습니다",
      "reason": "not-found"
    }
  }
}
