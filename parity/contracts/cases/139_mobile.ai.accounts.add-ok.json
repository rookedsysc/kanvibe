{
  "seq": 139,
  "id": "mobile.ai.accounts.add-ok",
  "group": "ai",
  "route": "POST /api/mobile/ai/accounts",
  "title": "add a KanVibe-managed account (201)",
  "transport": "http",
  "request": {
    "method": "POST",
    "path": "/api/mobile/ai/accounts",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "provider": "claude",
      "accountName": "work"
    }
  },
  "capture": {
    "ai_account_id": "body.accountId"
  },
  "expect": {
    "status": 201,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "accountId": "{{any:hex64}}"
    }
  }
}
