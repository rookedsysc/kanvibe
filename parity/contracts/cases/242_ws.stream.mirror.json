{
  "seq": 242,
  "id": "ws.stream.mirror",
  "group": "ws",
  "route": "WS /api/mobile/stream",
  "title": "resize claims the viewport and returns a snapshot; keystrokes echo; invalid resize ignored",
  "transport": "ws",
  "request": {
    "path": "/api/mobile/stream?taskId={{var:task_id}}&paneId=%250",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}"
    }
  },
  "steps": [
    {
      "op": "send_binary",
      "json": {
        "type": "resize",
        "cols": 80,
        "rows": 24
      }
    },
    {
      "op": "recv",
      "timeout": 10
    },
    {
      "op": "sleep",
      "seconds": 2
    },
    {
      "op": "send_text",
      "text": "echo kv-contract-$((6*7))\r"
    },
    {
      "op": "recv_until",
      "contains": "kv-contract-42",
      "timeout": 10
    },
    {
      "op": "send_binary",
      "json": {
        "type": "refresh-history"
      }
    },
    {
      "op": "send_binary",
      "json": {
        "type": "resize",
        "cols": 0,
        "rows": 24
      }
    },
    {
      "op": "send_text",
      "text": "echo kv-alive-$((7*6))\r"
    },
    {
      "op": "recv_until",
      "contains": "kv-alive-42",
      "timeout": 10
    },
    {
      "op": "close"
    }
  ],
  "expect": {
    "handshake": {
      "status": 101
    },
    "frames": [
      {
        "kind": "text",
        "text": "{{any:string}}"
      },
      {
        "kind": "text",
        "text": "{{contains:kv-contract-42}}"
      },
      {
        "kind": "text",
        "text": "{{contains:kv-alive-42}}"
      }
    ]
  }
}
