{
  "seq": 184,
  "id": "hook.status.case-insensitive",
  "group": "hook-status",
  "route": "POST /api/hooks/status",
  "title": "status is lowercased; agentSession accepted",
  "transport": "http",
  "request": {
    "method": "POST",
    "path": "/api/hooks/status",
    "listener": "plain",
    "headers": {
