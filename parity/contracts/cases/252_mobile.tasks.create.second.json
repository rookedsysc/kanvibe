{
  "seq": 252,
  "id": "mobile.tasks.create.second",
  "group": "tasks",
  "route": "POST /api/mobile/tasks",
  "title": "task to delete over the events socket",
  "transport": "http",
  "request": {
    "method": "POST",
    "path": "/api/mobile/tasks",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "projectId": "{{var:project_id}}",
      "branchName": "feat-del",
      "baseBranch": "main",
      "sessionType": "tmux"
    }
  },
  "capture": {
    "delete_task_id": "body.task.id"
  },
  "delay_before": 1.2,
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "task": {
        "title": "feat-del",
        "description": null,
        "status": "todo",
        "branchName": "feat-del",
        "sessionType": "tmux",
        "sshHost": null,
        "projectId": "{{var:project_id}}",
        "baseBranch": "main",
        "priority": null,
        "worktreePath": "{{var:demo_repo}}__worktrees/feat-del",
        "sessionName": "demo-feat-del",
        "agentType": null,
        "prUrl": null,
        "id": "{{any:uuid}}",
        "createdAt": "{{any:iso8601}}",
        "updatedAt": "{{any:iso8601}}"
      }
    }
  }
}
