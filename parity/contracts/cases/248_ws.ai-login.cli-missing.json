{
  "seq": 248,
  "id": "ws.ai-login.cli-missing",
  "group": "ws",
  "route": "WS /api/mobile/ai/accounts/:accountId/login",
  "title": "login PTY: ready, output, exit (provider CLI is absent in the contract environment), close 1000",
  "transport": "ws",
  "request": {
    "path": "/api/mobile/ai/accounts/{{var:ai_account_id}}/login?cols=80&rows=24",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}"
    }
  },
  "steps": [
    {
      "op": "recv",
      "timeout": 10
    },
    {
      "op": "recv",
      "timeout": 10
    },
    {
      "op": "recv",
      "timeout": 10
    },
    {
      "op": "expect_close",
      "timeout": 10
    }
  ],
  "expect": {
    "handshake": {
      "status": 101
    },
    "frames": [
      {
        "kind": "text",
        "json": {
          "type": "ready"
        }
      },
      {
        "kind": "text",
        "json": {
          "type": "output",
          "data": "{{any:string}}"
        }
      },
      {
        "kind": "text",
        "json": {
          "type": "exit",
          "exitCode": 1
        }
      },
      {
        "kind": "close",
        "code": 1000,
        "reason": "login-finished"
      }
    ]
  }
}
