{
  "seq": 238,
  "id": "ws.events.tls",
  "group": "ws",
  "route": "WS /api/mobile/events",
  "title": "events over WSS with the pinned certificate",
  "transport": "ws",
  "request": {
    "path": "/api/mobile/events",
    "listener": "tls",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}"
    }
  },
  "steps": [
    {
      "op": "recv"
    },
    {
      "op": "send_text",
      "json": {
        "type": "command",
        "requestId": "t1",
        "command": "get-pane-chat-modes",
        "taskId": "{{var:task_id}}"
      }
    },
    {
      "op": "recv_until",
      "where": {
        "type": "command-result",
        "requestId": "t1"
      },
      "timeout": 20
    },
    {
      "op": "close"
    }
  ],
  "expect": {
    "handshake": {
      "status": 101,
      "tls": {
        "peer_certificate_sha256": "{{var:tls_fingerprint}}"
      }
    },
    "frames": [
      {
        "kind": "text",
        "json": {
          "type": "connected",
          "commands": [
            "delete-task",
            "remove-task-registration",
            "get-tab-close-info",
            "close-tab",
            "start-session",
            "set-pane-chat-subscription",
            "get-pane-chat-modes",
            "set-pane-chat-mode"
          ]
        }
      },
      {
        "kind": "text",
        "json": {
          "type": "command-result",
          "requestId": "t1",
          "ok": true,
          "modes": {}
        }
      }
    ]
  }
}
