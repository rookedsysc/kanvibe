{
  "seq": 110,
  "id": "mobile.workspace-file.ok",
  "group": "workspace",
  "route": "GET /api/mobile/tasks/:taskId/workspace-file",
  "title": "read a worktree file",
  "transport": "http",
  "request": {
    "method": "GET",
    "path": "/api/mobile/tasks/{{var:task_id}}/workspace-file?path=README.md",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}"
    }
  },
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "file": {
        "path": "README.md",
        "content": "# demo\n"
      }
    }
  }
}
