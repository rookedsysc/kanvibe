{
  "seq": 222,
  "id": "cli.tasks.register.ok",
  "group": "task-cli",
  "route": "POST /api/cli/tasks/register",
  "title": "register a worktree created outside KanVibe",
  "transport": "http",
  "request": {
    "method": "POST",
    "path": "/api/cli/tasks/register",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:task_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "contextTaskId": "{{var:task_id}}",
      "branchName": "existing-branch"
    }
  },
  "capture": {
    "registered_task_id": "body.data.id"
  },
  "oracles": [
    {
      "name": "git",
      "args": {
        "cwd": "{{var:demo_repo}}",
        "args": [
          "worktree",
          "add",
          "-q",
          "{{var:demo_repo}}__worktrees/existing-branch",
          "existing-branch"
        ]
      }
    }
  ],
  "setup": [
    "git worktree add <demo>__worktrees/existing-branch existing-branch (peer created the worktree)"
  ],
  "delay_before": 1.2,
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "data": {
        "id": "{{any:uuid}}",
        "branchName": "existing-branch"
      }
    }
  }
}
