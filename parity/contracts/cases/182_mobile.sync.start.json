{
  "seq": 182,
  "id": "mobile.sync.start",
  "group": "sessions",
  "route": "POST /api/mobile/sync/start",
  "title": "start background sync (returns the status at start time)",
  "transport": "http",
  "request": {
    "method": "POST",
    "path": "/api/mobile/sync/start",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}"
    }
  },
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "status": {
        "phase": "{{any:string}}",
        "isRunning": "{{any:bool}}",
        "completedStages": "{{any:int}}",
        "reviewNeeded": false,
        "boardUpdated": false,
        "error": null
      }
    }
  }
}
