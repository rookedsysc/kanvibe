{
  "seq": 117,
  "id": "mobile.files.get.ok",
  "group": "workspace",
  "route": "GET /api/mobile/tasks/:id/files",
  "title": "original and current content of a changed file",
  "transport": "http",
  "request": {
    "method": "GET",
    "path": "/api/mobile/tasks/{{var:task_id}}/files?path=notes/todo.txt",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}"
    }
  },
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "original": "first line\nsecond line",
      "content": "first line\nedited in worktree\n"
    }
  }
}
