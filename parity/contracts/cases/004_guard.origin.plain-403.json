{
  "seq": 4,
  "id": "guard.origin.plain-403",
  "group": "guard",
  "route": "GUARD Origin",
  "title": "any request carrying an Origin header is rejected before routing",
  "transport": "http",
  "request": {
    "method": "GET",
    "path": "/api/hooks/health",
    "listener": "plain",
    "headers": {
      "Origin": "http://evil.example"
    }
  },
  "expect": {
    "status": 403,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": false,
      "error": "브라우저 요청은 허용하지 않습니다"
    }
  }
}
