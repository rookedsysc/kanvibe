{
  "seq": 160,
  "id": "mobile.pane-chat.prompt.bogus-token",
  "group": "pane-chat",
  "route": "POST /api/mobile/tasks/:taskId/pane-chat/prompt",
  "title": "prompt with a stale target token",
  "transport": "http",
  "request": {
    "method": "POST",
    "path": "/api/mobile/tasks/{{var:task_id}}/pane-chat/prompt",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "targetToken": "bogus-token",
      "text": "hi",
      "attachmentIds": [],
      "requestId": "req-1"
    }
  },
  "expect": {
    "status": 409,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": false,
      "error": "CLI 대상이 변경되었습니다. 현재 pane을 다시 확인해 주세요.",
      "reason": "target-changed"
    }
  }
}
