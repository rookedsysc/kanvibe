{
  "seq": 225,
  "id": "cli.tasks.delete.default-branch-403",
  "group": "task-cli",
  "route": "POST /api/cli/tasks/delete",
  "title": "default-branch task cannot be deleted by CLI",
  "transport": "http",
  "request": {
    "method": "POST",
    "path": "/api/cli/tasks/delete",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:task_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "contextTaskId": "{{var:task_id}}",
      "branchName": "main",
      "confirmed": true
    }
  },
  "expect": {
    "status": 403,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": false,
      "error": "프로젝트 기본 브랜치(main)의 task는 CLI로 지울 수 없습니다. KanVibe 화면에서 지우세요."
    }
  }
}
