{
  "seq": 228,
  "id": "cli.tasks.delete.ok",
  "group": "task-cli",
  "route": "POST /api/cli/tasks/delete",
  "title": "delete the CLI-created task",
  "transport": "http",
  "request": {
    "method": "POST",
    "path": "/api/cli/tasks/delete",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:task_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "contextTaskId": "{{var:task_id}}",
      "branchName": "cli-b",
      "confirmed": true,
      "propagateToPeers": false
    }
  },
  "oracles": [
    {
      "name": "read_json_file",
      "args": {
        "path": "{{var:cli_task_worktree}}/.kanvibe/targets.json"
      },
      "save": {
        "cli_task_token": "targets[0].token"
      }
    }
  ],
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "data": {
        "id": "{{var:cli_task_id}}",
        "branchName": "cli-b",
        "deleted": true,
        "peers": []
      }
    }
  }
}
