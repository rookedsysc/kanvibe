{
  "seq": 27,
  "id": "mobile.settings.patch-sort-and-sync",
  "group": "settings",
  "route": "PATCH /api/mobile/settings",
  "title": "sort, done alert and background sync",
  "transport": "http",
  "request": {
    "method": "PATCH",
    "path": "/api/mobile/settings",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "sortPreference": {
        "keys": [
          {
            "field": "priority",
            "direction": "desc"
          }
        ]
      },
      "doneAlertDismissed": true,
      "backgroundSync": {
        "isEnabled": false,
        "intervalMs": 120000
      }
    }
  },
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "settings": {
        "defaultSessionType": "tmux",
        "sortPreference": {
          "keys": [
            {
              "field": "priority",
              "direction": "desc"
            }
          ]
        },
        "doneAlertDismissed": true,
        "backgroundSync": {
          "isEnabled": false,
          "intervalMs": 120000
        }
      }
    }
  }
}
