{
  "seq": 91,
  "id": "mobile.tasks.tabs.create",
  "group": "tasks",
  "route": "POST /api/mobile/tasks/:taskId/tabs",
  "title": "open a second terminal tab",
  "transport": "http",
  "request": {
    "method": "POST",
    "path": "/api/mobile/tasks/{{var:task_id}}/tabs",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}"
    }
  },
  "capture": {
    "second_pane_id": "body.paneId",
    "second_tab_id": "body.surfaces.tabs[1].id"
  },
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "surfaces": {
        "taskId": "{{var:task_id}}",
        "sessionType": "tmux",
        "canResize": true,
        "canRefreshHistory": false,
        "canPrepareDirectConnection": false,
        "tabs": [
          {
            "id": "@0",
            "name": "{{regex:tmux|bash}}",
            "panes": [
              {
                "id": "%0",
                "tabId": "@0",
                "tabName": "{{regex:tmux|bash}}",
                "command": "bash",
                "left": 0,
                "top": 0,
                "width": 120,
                "height": 30
              }
            ]
          },
          {
            "id": "@1",
            "name": "{{regex:tmux|bash}}",
            "panes": [
              {
                "id": "%1",
                "tabId": "@1",
                "tabName": "{{regex:tmux|bash}}",
                "command": "bash",
                "left": 0,
                "top": 0,
                "width": 80,
                "height": 24
              }
            ]
          }
        ]
      },
      "paneId": "%1"
    }
  }
}
