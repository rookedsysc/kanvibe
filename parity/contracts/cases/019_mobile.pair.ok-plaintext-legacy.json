{
  "seq": 19,
  "id": "mobile.pair.ok-plaintext-legacy",
  "group": "pairing",
  "route": "POST /api/mobile/pair",
  "title": "legacy plaintext pairing on the hook port (deviceName > 64 chars is truncated)",
  "transport": "http",
  "request": {
    "method": "POST",
    "path": "/api/mobile/pair",
    "listener": "plain",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "code": "{{var:pairing_code_b}}",
      "deviceName": "Device B xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    }
  },
  "capture": {
    "device_b_token": "body.token"
  },
  "oracles": [
    {
      "name": "issue_pairing_code",
      "save": {
        "pairing_code_b": "code"
      }
    }
  ],
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "token": "{{any:hex64}}"
    }
  }
}
