{
  "seq": 72,
  "id": "mobile.tasks.create.ok",
  "group": "tasks",
  "route": "POST /api/mobile/tasks",
  "title": "create a tmux task (worktree + hooks + targets.json)",
  "transport": "http",
  "request": {
    "method": "POST",
    "path": "/api/mobile/tasks",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "projectId": "{{var:project_id}}",
      "branchName": "feat-a",
      "baseBranch": "main",
      "description": "  contract task  ",
      "priority": "medium",
      "sessionType": "tmux"
    }
  },
  "capture": {
    "task_id": "body.task.id",
    "task_worktree": "body.task.worktreePath"
  },
  "delay_before": 1.2,
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "task": {
        "title": "feat-a",
        "description": "contract task",
        "status": "todo",
        "branchName": "feat-a",
        "sessionType": "tmux",
        "sshHost": null,
        "projectId": "{{var:project_id}}",
        "baseBranch": "main",
        "priority": "medium",
        "worktreePath": "{{var:demo_repo}}__worktrees/feat-a",
        "sessionName": "demo-feat-a",
        "agentType": null,
        "prUrl": null,
        "id": "{{any:uuid}}",
        "createdAt": "{{any:iso8601}}",
        "updatedAt": "{{any:iso8601}}"
      }
    }
  }
}
