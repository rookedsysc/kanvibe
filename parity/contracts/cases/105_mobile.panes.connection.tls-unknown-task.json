{
  "seq": 105,
  "id": "mobile.panes.connection.tls-unknown-task",
  "group": "tasks",
  "route": "POST /api/mobile/tasks/:taskId/panes/:paneId/connection",
  "title": "TLS request for an unknown task",
  "transport": "http",
  "request": {
    "method": "POST",
    "path": "/api/mobile/tasks/00000000-0000-4000-8000-000000000000/panes/%250/connection",
    "listener": "tls",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}"
    }
  },
  "expect": {
    "status": 409,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "success": false,
      "reason": "no-session"
    },
    "tls": {
      "peer_certificate_sha256": "{{var:tls_fingerprint}}"
    }
  }
}
