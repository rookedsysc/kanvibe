{
  "seq": 85,
  "id": "mobile.tasks.status.ok",
  "group": "tasks",
  "route": "PATCH /api/mobile/tasks/:taskId/status",
  "title": "move task to pending (creates a notification)",
  "transport": "http",
  "request": {
    "method": "PATCH",
    "path": "/api/mobile/tasks/{{var:task_id}}/status",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "status": "pending"
    }
  },
  "delay_before": 1.1,
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "task": {
        "id": "{{var:task_id}}",
        "title": "feat-a",
        "description": "updated description",
        "status": "pending",
        "branchName": "feat-a",
        "worktreePath": "{{var:task_worktree}}",
        "sessionType": "tmux",
        "sessionName": "demo-feat-a",
        "sshHost": null,
        "agentType": null,
        "projectId": "{{var:project_id}}",
        "baseBranch": "main",
        "prUrl": null,
        "priority": "high",
        "createdAt": "{{any:iso8601}}",
        "updatedAt": "{{any:iso8601}}"
      }
    }
  }
}
