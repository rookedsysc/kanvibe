{
  "seq": 93,
  "id": "mobile.tabs.rename.ok",
  "group": "tasks",
  "route": "PATCH /api/mobile/tasks/:id/tabs/:tabId",
  "title": "rename second tab",
  "transport": "http",
  "request": {
    "method": "PATCH",
    "path": "/api/mobile/tasks/{{var:task_id}}/tabs/{{var:second_tab_id}}",
    "listener": "plain",
    "headers": {
      "Authorization": "Bearer {{var:pair_token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "name": "logs"
    }
  },
  "expect": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": null
    },
    "body": {
      "success": true,
      "tabs": [
        {
          "id": "@0",
          "nativeIndex": 0,
          "name": "{{regex:tmux|bash}}",
          "isActive": false
        },
        {
          "id": "@1",
          "nativeIndex": 1,
          "name": "logs",
          "isActive": true
        }
      ]
    }
  }
}
