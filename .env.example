# Optional desktop runtime configuration.
# Pass these variables explicitly to the desktop app process; .env is not loaded automatically.
# Example: KANVIBE_APP_DATA_DIR=/absolute/path/to/qa-data pnpm dev

# Directory containing kanvibe.db when KANVIBE_DB_PATH is not set.
# KANVIBE_APP_DATA_DIR=/absolute/path/to/kanvibe-data

# Explicit SQLite database file; takes precedence over KANVIBE_APP_DATA_DIR for database selection.
# KANVIBE_DB_PATH=/absolute/path/to/kanvibe-data/kanvibe.db

# Hook and mobile API port. Defaults: development/debug 19736, release 9736.
# KANVIBE_HOOK_PORT=19736

# Optional mobile background push relay. Set both values to enable relay delivery.
# KANVIBE_MOBILE_PUSH_RELAY_URL=https://push.example.com/notifications
# KANVIBE_MOBILE_PUSH_RELAY_TOKEN=<same-secret-as-relay-config>
