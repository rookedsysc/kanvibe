{
  "name": "kanvibe",
  "version": "1.0.2",
  "private": true,
  "description": "AI agent task management Kanban board with embedded SQLite desktop packaging.",
  "author": "rookedsysc",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.6.0",
  "main": "electron/main.js",
  "scripts": {
    "predev": "node scripts/ensure-native-runtime.cjs --electron",
    "predb:prepare": "node scripts/ensure-native-runtime.cjs",
    "predesktop:dev": "node scripts/ensure-native-runtime.cjs --electron",
    "prestart": "node scripts/ensure-native-runtime.cjs --electron",
    "dev": "node scripts/run-desktop-dev.cjs",
    "build": "pnpm build:renderer && pnpm build:main",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-desktop-main.cjs",
    "start": "node scripts/run-desktop-start.cjs",
    "desktop:dev": "node scripts/run-desktop-dev.cjs",
    "db:prepare": "tsx scripts/build-seed-db.ts",
    "rebuild:native:electron": "electron-rebuild -f --only better-sqlite3",
    "dist": "pnpm db:prepare && pnpm build && pnpm rebuild:native:electron && electron-builder --mac dmg",
    "deploy": "node scripts/dist-deploy.cjs",
    "dist:dir": "pnpm db:prepare && pnpm build && pnpm rebuild:native:electron && electron-builder --dir",
    "docs:dev": "pnpm --dir docs-site install && pnpm --dir docs-site dev",
    "docs:build": "pnpm --dir docs-site install && pnpm --dir docs-site build",
    "docs:start": "pnpm --dir docs-site install && pnpm --dir docs-site start",
    "lint": "eslint",
    "check": "tsc --noEmit",
    "test:e2e:login": "bash -lc 'for port in 4884 4885; do fuser -k \"$port\"/tcp 2>/dev/null || true; done; rm -f .next/dev/lock; playwright test tests/e2e/login.spec.js'",
    "qa:electron:prepare": "pnpm build && node scripts/ensure-native-runtime.cjs --electron",
    "qa:electron": "pnpm qa:electron:prepare && bash scripts/qa-electron.sh",
    "qa:electron:video": "pnpm qa:electron:prepare && bash scripts/qa-electron-video.sh",
    "qa:baseline": "node scripts/capture-electron-baseline.cjs",
    "qa:move-autocomplete": "pnpm exec vitest run src/components/__tests__/Board.test.tsx -t \"자동 완성\" && pnpm qa:electron:prepare && bash scripts/qa-move-autocomplete-video.sh",
    "qa:ai-session-history": "pnpm exec vitest run src/lib/aiSessions && pnpm exec vitest run src/desktop/renderer/routes/__tests__/TaskDetailRoute.test.tsx && pnpm qa:electron:prepare && bash scripts/qa-ai-session-history-video.sh",
    "qa:pr275-pr276": "bash scripts/qa-pr275-pr276.sh",
    "qa:scenarios": "node scripts/build-qa-scenarios.cjs",
    "qa:seed": "node scripts/ensure-native-runtime.cjs && tsx scripts/build-qa-seed-db.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@lobehub/icons-static-svg": "^1.91.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.9.0",
    "dompurify": "^3.4.2",
    "dunder-proto": "^1.0.1",
    "marked": "^18.0.3",
    "ms": "^2.1.3",
    "next-intl": "^4.8.2",
    "node-pty": "^1.1.0",
    "react": "19.2.3",
    "react-colorful": "^5.6.1",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.9.4",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.21.0",
    "typeorm": "^0.3.28",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^32.3.3",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^28.1.0",
    "typescript-eslint": "^8.33.1",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vite": "^7.1.10",
    "vitest": "^4.0.18"
  }
}
