{
  "name": "kanvibe",
  "version": "1.5.0",
  "private": true,
  "description": "AI agent task management Kanban desktop app powered by Tauri and Rust.",
  "author": "rookedsysc",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tauri dev",
    "desktop:dev": "tauri dev",
    "start": "tauri dev",
    "build:renderer": "vite build",
    "build": "tauri build --no-bundle",
    "dist": "tauri build",
    "dist:dir": "tauri build --no-bundle",
    "lint": "eslint src vite.config.ts vitest.config.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "docs:dev": "pnpm --dir docs-site dev",
    "docs:build": "pnpm --dir docs-site build",
    "docs:start": "pnpm --dir docs-site start",
    "qa:tauri:prepare": "tauri build --debug --no-bundle",
    "qa:tauri": "pnpm qa:tauri:prepare && node qa/tauri/flows/parity.cjs"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.34.5",
      "onFail": "error"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@lobehub/icons-static-svg": "^1.91.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.2",
    "marked": "^18.0.3",
    "mermaid": "^11.15.0",
    "next-intl": "^4.8.2",
    "react": "19.2.3",
    "react-colorful": "^5.6.1",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.9.4",
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^7.1.10",
    "vitest": "^4.0.18",
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-react-swc": "^4.3.3"
  }
}
