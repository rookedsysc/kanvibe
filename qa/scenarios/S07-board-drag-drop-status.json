{
  "$schema": "./scenario.schema.json",
  "seed": "qa/seed/kanvibe-seed.sqlite",
  "id": "S07-board-drag-drop-status",
  "title": "Dragging a card updates status and display order",
  "coverage": [
    "drag-drop",
    "kanban.updateTaskStatus",
    "display-order",
    "board-refresh"
  ],
  "steps": [
    {
      "action": "launchApp",
      "seed": "qa/seed/kanvibe-seed.sqlite",
      "locale": "ko",
      "theme": "dark",
      "viewport": {
        "width": 1440,
        "height": 960
      }
    },
    {
      "action": "waitForBoardReady"
    },
    {
      "action": "dragTaskToColumn",
      "taskId": "qa-task-todo-local",
      "toStatus": "progress",
      "position": 0
    },
    {
      "action": "captureScreen",
      "name": "drag-drop-progress"
    }
  ],
  "assertions": [
    {
      "type": "taskVisible",
      "taskId": "qa-task-todo-local",
      "status": "progress"
    },
    {
      "type": "dbRow",
      "table": "kanban_tasks",
      "where": {
        "id": "qa-task-todo-local"
      },
      "expected": {
        "status": "progress"
      }
    }
  ],
  "artifacts": {
    "screens": [
      "screens/S07-drag-drop-progress.png"
    ],
    "videos": [
      "videos/S07-board-drag-drop-status.mp4"
    ]
  }
}
