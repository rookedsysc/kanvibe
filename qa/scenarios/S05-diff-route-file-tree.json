{
  "$schema": "./scenario.schema.json",
  "seed": "qa/seed/kanvibe-seed.sqlite",
  "id": "S05-diff-route-file-tree",
  "title": "Diff route shows changed files and file diff pane",
  "coverage": [
    "diff-route",
    "git-diff",
    "file-tree",
    "monaco-parity"
  ],
  "steps": [
    {
      "action": "launchApp",
      "seed": "qa/seed/kanvibe-seed.sqlite",
      "locale": "ko",
      "theme": "dark",
      "viewport": {
        "width": 1440,
        "height": 960
      }
    },
    {
      "action": "waitForBoardReady"
    },
    {
      "action": "openDiffRoute",
      "taskId": "qa-task-review-diff"
    },
    {
      "action": "selectFirstChangedFile"
    },
    {
      "action": "captureScreen",
      "name": "diff-route-file-tree"
    }
  ],
  "assertions": [
    {
      "type": "route",
      "pattern": "/diff/qa-task-review-diff"
    },
    {
      "type": "diffSidebarVisible"
    },
    {
      "type": "diffPaneVisible"
    },
    {
      "type": "externalToolBlockerAllowed",
      "tools": [
        "git"
      ]
    }
  ],
  "artifacts": {
    "screens": [
      "screens/S05-diff-route-file-tree.png"
    ],
    "videos": [
      "videos/S05-diff-route-file-tree.mp4"
    ]
  }
}
