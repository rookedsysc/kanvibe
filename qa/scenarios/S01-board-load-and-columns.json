{
  "$schema": "./scenario.schema.json",
  "seed": "qa/seed/kanvibe-seed.sqlite",
  "id": "S01-board-load-and-columns",
  "title": "Board loads all status columns and seeded cards",
  "coverage": [
    "board",
    "columns",
    "seed-db",
    "project-colors",
    "priority-badges"
  ],
  "steps": [
    {
      "action": "launchApp",
      "seed": "qa/seed/kanvibe-seed.sqlite",
      "locale": "ko",
      "theme": "dark",
      "viewport": {
        "width": 1440,
        "height": 960
      }
    },
    {
      "action": "waitForBoardReady"
    },
    {
      "action": "captureScreen",
      "name": "board-dark-ko"
    }
  ],
  "assertions": [
    {
      "type": "columns",
      "statuses": [
        "todo",
        "progress",
        "pending",
        "review",
        "done"
      ]
    },
    {
      "type": "taskCountByStatus",
      "expected": {
        "todo": 3,
        "progress": 3,
        "pending": 3,
        "review": 3,
        "done": 3
      }
    },
    {
      "type": "taskVisible",
      "taskId": "qa-task-todo-local",
      "title": "Draft native board shell"
    },
    {
      "type": "dbCount",
      "table": "projects",
      "expected": 3
    },
    {
      "type": "dbCount",
      "table": "kanban_tasks",
      "expected": 15
    }
  ],
  "artifacts": {
    "screens": [
      "screens/S01-board-dark-ko.png"
    ],
    "videos": [
      "videos/S01-board-load-and-columns.mp4"
    ]
  }
}
