{
  "$schema": "./scenario.schema.json",
  "seed": "qa/seed/kanvibe-seed.sqlite",
  "id": "S08-context-menu-status-and-delete",
  "title": "Context menu changes status and delete cleans task row",
  "coverage": [
    "context-menu",
    "delete-task",
    "done-confirm",
    "resource-cleanup",
    "project-color"
  ],
  "steps": [
    {
      "action": "launchApp",
      "seed": "qa/seed/kanvibe-seed.sqlite",
      "locale": "ko",
      "theme": "dark",
      "viewport": {
        "width": 1440,
        "height": 960
      }
    },
    {
      "action": "waitForBoardReady"
    },
    {
      "action": "openTaskDetail",
      "taskId": "qa-task-todo-local"
    },
    {
      "action": "setProjectColor",
      "projectId": "qa-project-kanvibe",
      "color": "#5EEAD4"
    },
    {
      "action": "openTaskContextMenu",
      "taskId": "qa-task-pending-no-branch"
    },
    {
      "action": "chooseContextAction",
      "actionName": "moveToReview"
    },
    {
      "action": "openTaskContextMenu",
      "taskId": "qa-task-pending-no-branch"
    },
    {
      "action": "chooseContextAction",
      "actionName": "deleteTask"
    },
    {
      "action": "confirmDialog"
    },
    {
      "action": "captureScreen",
      "name": "context-delete-result"
    }
  ],
  "assertions": [
    {
      "type": "taskField",
      "taskId": "qa-task-todo-local",
      "field": "project_color",
      "expected": "#5EEAD4",
      "eventually": true
    },
    {
      "type": "taskNotVisible",
      "taskId": "qa-task-pending-no-branch"
    },
    {
      "type": "dbMissing",
      "table": "kanban_tasks",
      "where": {
        "id": "qa-task-pending-no-branch"
      }
    }
  ],
  "artifacts": {
    "screens": [
      "screens/S08-context-delete-result.png"
    ],
    "videos": [
      "videos/S08-context-menu-status-and-delete.mp4"
    ]
  }
}
