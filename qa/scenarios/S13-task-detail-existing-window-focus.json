{
  "$schema": "./scenario.schema.json",
  "seed": "qa/seed/kanvibe-seed.sqlite",
  "id": "S13-task-detail-existing-window-focus",
  "title": "Opening an already-open task detail focuses the existing route",
  "coverage": [
    "window-policy",
    "task-navigation",
    "desktop-preload",
    "shortcut-routing"
  ],
  "steps": [
    {
      "action": "launchApp",
      "seed": "qa/seed/kanvibe-seed.sqlite",
      "locale": "ko",
      "theme": "dark",
      "viewport": {
        "width": 1440,
        "height": 960
      }
    },
    {
      "action": "waitForBoardReady"
    },
    {
      "action": "openTaskDetail",
      "taskId": "qa-task-progress-pr"
    },
    {
      "action": "recordWindowCount",
      "name": "beforeSecondOpen"
    },
    {
      "action": "openTaskDetail",
      "taskId": "qa-task-progress-pr"
    },
    {
      "action": "captureScreen",
      "name": "existing-window-focus"
    }
  ],
  "assertions": [
    {
      "type": "windowCountUnchanged",
      "baseline": "beforeSecondOpen"
    },
    {
      "type": "route",
      "pattern": "/task/qa-task-progress-pr"
    },
    {
      "type": "taskTitleVisible",
      "title": "Wire PR status card"
    }
  ],
  "artifacts": {
    "screens": [
      "screens/S13-existing-window-focus.png"
    ],
    "videos": [
      "videos/S13-task-detail-existing-window-focus.mp4"
    ]
  }
}
